<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the system while the app starts, before the first frame: the same dark backdrop as the editor. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="900dp" android:centerX="0.5" android:centerY="0.35"
                android:startColor="#1d1530" android:endColor="#0b0c10" />
        </shape>
    </item>
</layer-list>
